---
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso | SportMind</title>
    <meta name="description" content="Inicia sesión en SportMind para acceder a la plataforma de análisis de rendimiento deportivo." />

    <!-- Redirigir si ya hay sesión activa -->
    <script is:inline>
      (function () {
        const token = localStorage.getItem("sportmind_token");
        if (token) {
          try {
            const payload = JSON.parse(atob(token.split(".")[1]));
            if (!payload.exp || payload.exp * 1000 > Date.now()) {
              window.location.replace("/inicio");
            }
          } catch {}
        }
      })();
    </script>

    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

      * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', system-ui, sans-serif; }

      body {
        min-height: 100vh;
        background: linear-gradient(135deg, #eff6ff 0%, #f0f4f8 40%, #eef2ff 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }

      .bg-blob {
        position: fixed;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        z-index: 0;
      }

      .login-wrapper {
        display: flex;
        gap: 0;
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.10), 0 2px 8px rgba(0,0,0,0.05);
        overflow: hidden;
        width: 100%;
        max-width: 860px;
        min-height: 520px;
        position: relative;
        z-index: 1;
      }

      .login-hero {
        flex: 1;
        background: linear-gradient(145deg, #1e3a5f 0%, #1e293b 50%, #0f172a 100%);
        padding: 48px 40px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
      }
      .login-hero::before {
        content: '';
        position: absolute;
        top: -80px; right: -60px;
        width: 280px; height: 280px;
        background: radial-gradient(circle, rgba(59,130,246,0.2) 0%, transparent 70%);
      }
      .login-hero::after {
        content: '';
        position: absolute;
        bottom: -60px; left: -40px;
        width: 220px; height: 220px;
        background: radial-gradient(circle, rgba(139,92,246,0.15) 0%, transparent 70%);
      }
      .hero-brand {
        display: flex; align-items: center; gap: 14px;
        position: relative; z-index: 2;
      }
      .hero-brand-icon {
        width: 52px; height: 52px;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        border-radius: 16px;
        display: flex; align-items: center; justify-content: center;
        font-size: 26px;
        box-shadow: 0 6px 24px rgba(59,130,246,0.4);
      }
      .hero-brand h1 { font-size: 26px; font-weight: 800; color: #f1f5f9; letter-spacing: -0.5px; }
      .hero-brand p { font-size: 12px; color: #64748b; margin-top: 2px; font-weight: 500; }

      .hero-body { position: relative; z-index: 2; }
      .hero-body h2 {
        font-size: 28px; font-weight: 800;
        color: #f1f5f9; line-height: 1.25;
        margin-bottom: 12px;
      }
      .hero-body p { font-size: 14px; color: #94a3b8; line-height: 1.65; }

      .hero-features { position: relative; z-index: 2; }
      .feature-item {
        display: flex; align-items: center; gap: 10px;
        font-size: 13px; color: #94a3b8;
        margin-bottom: 10px;
      }
      .feature-item span.icon {
        font-size: 16px;
        width: 30px; height: 30px;
        background: rgba(255,255,255,0.07);
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
      }

      .login-form-panel {
        width: 380px;
        flex-shrink: 0;
        padding: 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: #ffffff;
      }

      .form-header { margin-bottom: 24px; }
      .form-header h2 { font-size: 22px; font-weight: 800; color: #1a202c; letter-spacing: -0.3px; }
      .form-header p { font-size: 14px; color: #718096; margin-top: 6px; line-height: 1.5; }

      .form-group { margin-bottom: 16px; }
      .form-label {
        display: block;
        font-size: 13px; font-weight: 600;
        color: #4a5568; margin-bottom: 6px;
      }
      .form-input {
        width: 100%;
        padding: 11px 14px;
        background: #f7fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        font-size: 14px; color: #1a202c;
        transition: all 0.2s ease;
        outline: none;
      }
      .form-input:focus {
        border-color: #3b82f6;
        background: #eff6ff;
        box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
      }

      .form-hint { font-size: 12px; color: #718096; margin-top: 6px; line-height: 1.5; }

      .btn-submit {
        width: 100%;
        padding: 12px;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: #fff;
        border: none; border-radius: 12px;
        font-size: 14px; font-weight: 700;
        cursor: pointer;
        transition: all 0.25s ease;
        margin-top: 6px;
        box-shadow: 0 4px 16px rgba(59,130,246,0.3);
      }
      .btn-submit:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(59,130,246,0.4); }
      .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }

      .toggle-mode {
        text-align: center;
        margin-top: 16px;
        font-size: 13px;
        color: #718096;
      }
      .toggle-mode button {
        background: none; border: none; color: #3b82f6;
        font-weight: 600; cursor: pointer; text-decoration: underline;
        font-size: 13px; padding: 0;
      }

      .msg-box {
        margin-top: 14px;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 13px; font-weight: 500;
        text-align: center;
        display: none;
      }
      .msg-box.visible { display: block; }
      .msg-box.loading { background: #eff6ff; color: #3b82f6; border: 1px solid #bfdbfe; }
      .msg-box.success { background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; }
      .msg-box.error   { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
      .msg-box.warning { background: #fffbeb; color: #d97706; border: 1px solid #fde68a; }

      @media (max-width: 680px) {
        .login-hero { display: none; }
        .login-form-panel { width: 100%; }
        .login-wrapper { max-width: 400px; }
      }
    </style>
  </head>

  <body>
    <div class="bg-blob" style="width:350px;height:350px;background:rgba(59,130,246,0.08);top:-100px;left:-80px;"></div>
    <div class="bg-blob" style="width:250px;height:250px;background:rgba(139,92,246,0.07);bottom:-50px;right:100px;"></div>

    <div class="login-wrapper">
      <!-- Panel Hero (izquierdo) -->
      <div class="login-hero">
        <div class="hero-brand">
          <div class="hero-brand-icon">🧠</div>
          <div>
            <h1>SportMind</h1>
            <p>Plataforma de Análisis Deportivo</p>
          </div>
        </div>

        <div class="hero-body">
          <h2>Comprende el estado mental de tus atletas</h2>
          <p>Visualiza sesiones, analiza emociones y obtén diagnósticos automáticos con inteligencia artificial.</p>
        </div>

        <div class="hero-features">
          <div class="feature-item"><span class="icon">📊</span> Evaluaciones en tiempo real desde la nube</div>
          <div class="feature-item"><span class="icon">🧠</span> Análisis de autorregulación emocional con IA</div>
          <div class="feature-item"><span class="icon">🔒</span> Acceso seguro unificado</div>
        </div>
      </div>

      <!-- Panel Formulario (derecho) -->
      <div class="login-form-panel">
        <div class="form-header">
          <h2 id="formTitle">Iniciar Sesión</h2>
          <p id="formSubtitle">Ingresa tus credenciales para acceder a la plataforma.</p>
        </div>

        <form id="loginForm" novalidate>
          <div class="form-group">
            <label class="form-label" for="email">Correo electrónico</label>
            <input
              type="email" id="email" name="email"
              class="form-input" placeholder="tu@correo.com"
              required autocomplete="email"
            />
          </div>

          <!-- Contraseña actual (para login) -->
          <div id="divPasswordActual" class="form-group">
            <label class="form-label" for="password">Contraseña</label>
            <input
              type="password" id="password" name="password"
              class="form-input" placeholder="••••••••"
              required autocomplete="current-password"
            />
          </div>

          <!-- Nueva contraseña (para primer ingreso o cambio de contraseña) -->
          <div id="divNuevaPassword" class="form-group" style="display:none;">
            <label class="form-label" for="newPassword" style="color:#d97706;">
              Nueva Contraseña
            </label>
            <input
              type="password" id="newPassword" name="newPassword"
              class="form-input" placeholder="Nueva contraseña segura"
            />
            <p id="hintText" class="form-hint">⚠️ Tu cuenta es nueva. Debes elegir una contraseña permanente para continuar.</p>
          </div>

          <button type="submit" id="btnSubmit" class="btn-submit">
            Entrar a SportMind
          </button>
        </form>

        <div class="toggle-mode">
          <button type="button" id="togglePasswordBtn">¿Olvidaste o quieres cambiar tu contraseña?</button>
        </div>

        <div id="mensaje" class="msg-box"></div>
      </div>
    </div>

    <script>
      const LOGIN_API_URL = "/api/login";

      let cognitoSession: string | undefined;
      let currentEmail: string | undefined;
      let isChangingPasswordMode = false;

      const loginForm = document.getElementById("loginForm") as HTMLFormElement;
      const emailInput = document.getElementById("email") as HTMLInputElement;
      const passwordInput = document.getElementById("password") as HTMLInputElement;
      const newPasswordInput = document.getElementById("newPassword") as HTMLInputElement;
      const divPasswordActual = document.getElementById("divPasswordActual") as HTMLElement;
      const divNuevaPassword = document.getElementById("divNuevaPassword") as HTMLElement;
      const formTitle = document.getElementById("formTitle") as HTMLElement;
      const formSubtitle = document.getElementById("formSubtitle") as HTMLElement;
      const hintText = document.getElementById("hintText") as HTMLElement;
      const btnSubmit = document.getElementById("btnSubmit") as HTMLButtonElement;
      const togglePasswordBtn = document.getElementById("togglePasswordBtn") as HTMLButtonElement;
      const msgEl = document.getElementById("mensaje") as HTMLElement;

      function showMsg(text: string, type: 'loading'|'success'|'error'|'warning') {
        msgEl.textContent = text;
        msgEl.className = `msg-box visible ${type}`;
      }

      // Alternar entre modo Login y modo Cambiar Contraseña
      togglePasswordBtn.addEventListener("click", () => {
        isChangingPasswordMode = !isChangingPasswordMode;
        msgEl.className = 'msg-box';

        if (isChangingPasswordMode) {
          formTitle.textContent = "Cambiar Contraseña";
          formSubtitle.textContent = "Ingresa tu correo y define tu nueva clave.";
          divPasswordActual.style.display = "none";
          passwordInput.required = false;
          divNuevaPassword.style.display = "block";
          newPasswordInput.required = true;
          hintText.textContent = "Introduce la nueva contraseña permanente.";
          btnSubmit.textContent = "Actualizar Contraseña";
          togglePasswordBtn.textContent = "← Volver a Iniciar Sesión";
        } else {
          formTitle.textContent = "Iniciar Sesión";
          formSubtitle.textContent = "Ingresa tus credenciales para acceder a la plataforma.";
          divPasswordActual.style.display = "block";
          passwordInput.required = true;
          divNuevaPassword.style.display = "none";
          newPasswordInput.required = false;
          btnSubmit.textContent = "Entrar a SportMind";
          togglePasswordBtn.textContent = "¿Olvidaste o quieres cambiar tu contraseña?";
        }
      });

      loginForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        const password = passwordInput.value;
        const newPassword = newPasswordInput.value;

        btnSubmit.disabled = true;

        if (isChangingPasswordMode) {
          showMsg("Actualizando contraseña...", "loading");
          try {
            const response = await fetch(LOGIN_API_URL, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                action: "changePassword",
                email,
                newPassword
              })
            });

            const result = await response.json();
            if (!response.ok || !result.success) throw new Error(result.error || "No se pudo actualizar la contraseña.");

            showMsg("✅ ¡Contraseña actualizada con éxito! Ya puedes iniciar sesión.", "success");
            setTimeout(() => {
              togglePasswordBtn.click(); // Volver al login
              btnSubmit.disabled = false;
            }, 1500);
          } catch (error: any) {
            showMsg("❌ " + (error.message || "Error al actualizar."), "error");
            btnSubmit.disabled = false;
          }
          return;
        }

        // Flujo normal de Login
        showMsg("Verificando credenciales...", "loading");

        try {
          let payload: any = { email, password };

          if (cognitoSession) {
            payload = {
              email: currentEmail,
              password,
              newPassword,
              session: cognitoSession,
              action: "respondChallenge"
            };
          } else {
            currentEmail = email;
          }

          const response = await fetch(LOGIN_API_URL, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });

          const result = await response.json();

          if (result.challenge === "NEW_PASSWORD_REQUIRED") {
            cognitoSession = result.session;
            divPasswordActual.style.display = "none";
            divNuevaPassword.style.display = "block";
            if (newPasswordInput) newPasswordInput.required = true;
            btnSubmit.textContent = "Guardar y Entrar";
            btnSubmit.disabled = false;
            showMsg("⚠️ Debes establecer una nueva contraseña.", "warning");
            return;
          }

          if (!response.ok || !result.success) {
            throw new Error(result.error || "Credenciales inválidas.");
          }

          localStorage.setItem("sportmind_token", result.token);
          showMsg("✅ ¡Bienvenido! Redirigiendo...", "success");
          setTimeout(() => { window.location.replace("/inicio"); }, 600);

        } catch (error: any) {
          console.error(error);
          showMsg("❌ " + (error.message || "Error al iniciar sesión."), "error");
          cognitoSession = undefined;
          btnSubmit.disabled = false;
        }
      });
    </script>
  </body>
</html> 