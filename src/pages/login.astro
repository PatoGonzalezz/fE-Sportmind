---
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso | SportMind</title>
    <meta name="description" content="Inicia sesión en SportMind para acceder a la plataforma de análisis de rendimiento deportivo." />

    <!-- Redirigir si ya hay sesión activa -->
    <script is:inline>
      (function () {
        const token = localStorage.getItem("sportmind_token");
        if (token) {
          try {
            const payload = JSON.parse(atob(token.split(".")[1]));
            if (!payload.exp || payload.exp * 1000 > Date.now()) {
              window.location.replace("/dashboard");
            }
          } catch {}
        }
      })();
    </script>

    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

      * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', system-ui, sans-serif; }

      body {
        min-height: 100vh;
        background: linear-gradient(135deg, #eff6ff 0%, #f0f4f8 40%, #eef2ff 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }

      /* Decoración de fondo */
      .bg-blob {
        position: fixed;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        z-index: 0;
      }

      /* Card principal */
      .login-wrapper {
        display: flex;
        gap: 0;
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.10), 0 2px 8px rgba(0,0,0,0.05);
        overflow: hidden;
        width: 100%;
        max-width: 860px;
        min-height: 520px;
        position: relative;
        z-index: 1;
      }

      /* Panel izquierdo – Hero */
      .login-hero {
        flex: 1;
        background: linear-gradient(145deg, #1e3a5f 0%, #1e293b 50%, #0f172a 100%);
        padding: 48px 40px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
      }
      .login-hero::before {
        content: '';
        position: absolute;
        top: -80px; right: -60px;
        width: 280px; height: 280px;
        background: radial-gradient(circle, rgba(59,130,246,0.2) 0%, transparent 70%);
      }
      .login-hero::after {
        content: '';
        position: absolute;
        bottom: -60px; left: -40px;
        width: 220px; height: 220px;
        background: radial-gradient(circle, rgba(139,92,246,0.15) 0%, transparent 70%);
      }
      .hero-brand {
        display: flex; align-items: center; gap: 14px;
        position: relative; z-index: 2;
      }
      .hero-brand-icon {
        width: 52px; height: 52px;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        border-radius: 16px;
        display: flex; align-items: center; justify-content: center;
        font-size: 26px;
        box-shadow: 0 6px 24px rgba(59,130,246,0.4);
      }
      .hero-brand h1 { font-size: 26px; font-weight: 800; color: #f1f5f9; letter-spacing: -0.5px; }
      .hero-brand p { font-size: 12px; color: #64748b; margin-top: 2px; font-weight: 500; }

      .hero-body { position: relative; z-index: 2; }
      .hero-body h2 {
        font-size: 28px; font-weight: 800;
        color: #f1f5f9; line-height: 1.25;
        margin-bottom: 12px;
      }
      .hero-body p { font-size: 14px; color: #94a3b8; line-height: 1.65; }

      .hero-features { position: relative; z-index: 2; }
      .feature-item {
        display: flex; align-items: center; gap: 10px;
        font-size: 13px; color: #94a3b8;
        margin-bottom: 10px;
      }
      .feature-item span.icon {
        font-size: 16px;
        width: 30px; height: 30px;
        background: rgba(255,255,255,0.07);
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
      }

      /* Panel derecho – Formulario */
      .login-form-panel {
        width: 360px;
        flex-shrink: 0;
        padding: 48px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: #ffffff;
      }

      .form-header { margin-bottom: 32px; }
      .form-header h2 { font-size: 22px; font-weight: 800; color: #1a202c; letter-spacing: -0.3px; }
      .form-header p { font-size: 14px; color: #718096; margin-top: 6px; line-height: 1.5; }

      .form-group { margin-bottom: 20px; }
      .form-label {
        display: block;
        font-size: 13px; font-weight: 600;
        color: #4a5568; margin-bottom: 6px;
      }
      .form-input {
        width: 100%;
        padding: 12px 14px;
        background: #f7fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        font-size: 15px; color: #1a202c;
        transition: all 0.2s ease;
        outline: none;
      }
      .form-input:focus {
        border-color: #3b82f6;
        background: #eff6ff;
        box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
      }
      .form-input::placeholder { color: #a0aec0; }

      .form-hint { font-size: 12px; color: #718096; margin-top: 6px; line-height: 1.5; }

      .btn-submit {
        width: 100%;
        padding: 13px;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: #fff;
        border: none; border-radius: 12px;
        font-size: 15px; font-weight: 700;
        cursor: pointer;
        transition: all 0.25s ease;
        margin-top: 8px;
        box-shadow: 0 4px 16px rgba(59,130,246,0.3);
        letter-spacing: 0.1px;
      }
      .btn-submit:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(59,130,246,0.4); }
      .btn-submit:active:not(:disabled) { transform: translateY(0); }
      .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

      .msg-box {
        margin-top: 16px;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 13px; font-weight: 500;
        text-align: center;
        display: none;
      }
      .msg-box.visible { display: block; }
      .msg-box.loading { background: #eff6ff; color: #3b82f6; border: 1px solid #bfdbfe; }
      .msg-box.success { background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; }
      .msg-box.error   { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
      .msg-box.warning { background: #fffbeb; color: #d97706; border: 1px solid #fde68a; }

      /* Responsive */
      @media (max-width: 680px) {
        .login-hero { display: none; }
        .login-form-panel { width: 100%; }
        .login-wrapper { max-width: 400px; }
      }
    </style>
  </head>

  <body>
    <!-- Blobs de fondo decorativos -->
    <div class="bg-blob" style="width:350px;height:350px;background:rgba(59,130,246,0.08);top:-100px;left:-80px;"></div>
    <div class="bg-blob" style="width:250px;height:250px;background:rgba(139,92,246,0.07);bottom:-50px;right:100px;"></div>

    <div class="login-wrapper">

      <!-- Panel Hero (izquierdo) -->
      <div class="login-hero">
        <div class="hero-brand">
          <div class="hero-brand-icon">🧠</div>
          <div>
            <h1>SportMind</h1>
            <p>Plataforma de Análisis Deportivo</p>
          </div>
        </div>

        <div class="hero-body">
          <h2>Comprende el estado mental de tus atletas</h2>
          <p>Visualiza sesiones, analiza emociones y obtén diagnósticos automáticos con inteligencia artificial.</p>
        </div>

        <div class="hero-features">
          <div class="feature-item"><span class="icon">📊</span> Evaluaciones en tiempo real desde la nube</div>
          <div class="feature-item"><span class="icon">🧠</span> Análisis de autorregulación emocional con IA</div>
          <div class="feature-item"><span class="icon">🔒</span> Acceso seguro con Amazon Cognito</div>
        </div>
      </div>

      <!-- Panel Formulario (derecho) -->
      <div class="login-form-panel">
        <div class="form-header">
          <h2>Iniciar Sesión</h2>
          <p>Ingresa tus credenciales para acceder a la plataforma.</p>
        </div>

        <form id="loginForm" novalidate>
          <div class="form-group">
            <label class="form-label" for="email">Correo electrónico</label>
            <input
              type="email" id="email" name="email"
              class="form-input" placeholder="tu@correo.com"
              required autocomplete="email"
            />
          </div>

          <div id="divPasswordActual" class="form-group">
            <label class="form-label" for="password">Contraseña</label>
            <input
              type="password" id="password" name="password"
              class="form-input" placeholder="••••••••"
              required autocomplete="current-password"
            />
          </div>

          <div id="divNuevaPassword" class="form-group" style="display:none;">
            <label class="form-label" for="newPassword" style="color:#d97706;">
              Nueva Contraseña
            </label>
            <input
              type="password" id="newPassword" name="newPassword"
              class="form-input" placeholder="Nueva contraseña segura"
            />
            <p class="form-hint">⚠️ Tu cuenta es nueva. Debes elegir una contraseña permanente para continuar.</p>
          </div>

          <button type="submit" id="btnSubmit" class="btn-submit">
            Entrar a SportMind
          </button>
        </form>

        <div id="mensaje" class="msg-box"></div>
      </div>
    </div>

    <script>
      import {
        CognitoIdentityProviderClient,
        InitiateAuthCommand,
        RespondToAuthChallengeCommand,
      } from "@aws-sdk/client-cognito-identity-provider";

      const REGION = "us-east-1";
      const CLIENT_ID = "4ul825nprfht1evlpqmf5v5jd3";

      const client = new CognitoIdentityProviderClient({ region: REGION });

      let cognitoSession: string | undefined;
      let currentEmail: string | undefined;

      const loginForm = document.getElementById("loginForm") as HTMLFormElement;
      const emailInput = document.getElementById("email") as HTMLInputElement;
      const passwordInput = document.getElementById("password") as HTMLInputElement;
      const newPasswordInput = document.getElementById("newPassword") as HTMLInputElement;
      const divPasswordActual = document.getElementById("divPasswordActual") as HTMLElement;
      const divNuevaPassword = document.getElementById("divNuevaPassword") as HTMLElement;
      const msgEl = document.getElementById("mensaje") as HTMLElement;
      const btnSubmit = document.getElementById("btnSubmit") as HTMLButtonElement;

      function showMsg(text: string, type: 'loading'|'success'|'error'|'warning') {
        msgEl.textContent = text;
        msgEl.className = `msg-box visible ${type}`;
      }
      function hideMsg() {
        msgEl.className = 'msg-box';
      }

      loginForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        const password = passwordInput.value;
        const newPassword = newPasswordInput.value;

        showMsg("Verificando credenciales...", "loading");
        btnSubmit.disabled = true;

        try {
          if (!cognitoSession) {
            currentEmail = email;
            const command = new InitiateAuthCommand({
              AuthFlow: "USER_PASSWORD_AUTH",
              ClientId: CLIENT_ID,
              AuthParameters: { USERNAME: email, PASSWORD: password },
            });
            const response = await client.send(command);

            if (response.ChallengeName === "NEW_PASSWORD_REQUIRED") {
              cognitoSession = response.Session;
              divPasswordActual.style.display = "none";
              divNuevaPassword.style.display = "block";
              if (newPasswordInput) newPasswordInput.required = true;
              btnSubmit.textContent = "Guardar y Entrar";
              btnSubmit.disabled = false;
              showMsg("Debes establecer una nueva contraseña para continuar.", "warning");
              return;
            }

            if (response.AuthenticationResult?.IdToken) {
              procesarLoginExitoso(response.AuthenticationResult.IdToken);
            } else {
              throw new Error("No se recibió el token de autenticación.");
            }
          } else {
            const command = new RespondToAuthChallengeCommand({
              ChallengeName: "NEW_PASSWORD_REQUIRED",
              ClientId: CLIENT_ID,
              Session: cognitoSession,
              ChallengeResponses: { USERNAME: currentEmail || "", NEW_PASSWORD: newPassword },
            });
            const response = await client.send(command);
            if (response.AuthenticationResult?.IdToken) {
              procesarLoginExitoso(response.AuthenticationResult.IdToken);
            } else {
              throw new Error("No se pudo establecer la nueva contraseña.");
            }
          }
        } catch (error) {
          console.error(error);
          const errorMsg = error instanceof Error ? error.message : "Credenciales incorrectas.";
          showMsg("❌ " + errorMsg, "error");
          cognitoSession = undefined;
          btnSubmit.disabled = false;
        }
      });

      function procesarLoginExitoso(idToken: string) {
        localStorage.setItem("sportmind_token", idToken);
        showMsg("✅ ¡Bienvenido! Redirigiendo...", "success");
        btnSubmit.disabled = true;
        setTimeout(() => { window.location.replace("/dashboard"); }, 600);
      }
    </script>
  </body>
</html>
