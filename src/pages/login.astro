---
import "../styles/global.css";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Login | SportMind</title>
        <!-- Si ya hay sesión activa y válida, redirigir al dashboard -->
        <script is:inline>
            (function () {
                const token = localStorage.getItem("sportmind_token");
                if (token) {
                    try {
                        const payload = JSON.parse(atob(token.split(".")[1]));
                        if (!payload.exp || payload.exp * 1000 > Date.now()) {
                            window.location.replace("/dashboard");
                        }
                    } catch {}
                }
            })();
        </script>
    </head>
    <body class="bg-slate-100 flex items-center justify-center h-screen">
        <div class="bg-white p-8 rounded-lg shadow-md w-96">
            <h2 class="text-2xl font-bold mb-6 text-center text-slate-800">
                Acceso SportMind
            </h2>

            <form id="loginForm" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700"
                        >Correo Electrónico</label
                    >
                    <input
                        type="email"
                        id="email"
                        class="mt-1 block w-full border border-slate-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500"
                        required
                    />
                </div>

                <div id="divPasswordActual">
                    <label class="block text-sm font-medium text-slate-700"
                        >Contraseña</label
                    >
                    <input
                        type="password"
                        id="password"
                        class="mt-1 block w-full border border-slate-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500"
                        required
                    />
                </div>

                <div id="divNuevaPassword" class="hidden">
                    <label class="block text-sm font-medium text-blue-600"
                        >Nueva Contraseña Definitiva</label
                    >
                    <input
                        type="password"
                        id="newPassword"
                        class="mt-1 block w-full border border-blue-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500"
                    />
                    <p class="text-xs text-slate-500 mt-1">
                        Tu cuenta es nueva, debes establecer una contraseña
                        segura.
                    </p>
                </div>

                <button
                    type="submit"
                    id="btnSubmit"
                    class="w-full bg-blue-600 text-white p-2 rounded-md hover:bg-blue-700 transition-colors"
                >
                    Iniciar Sesión
                </button>
            </form>

            <p id="mensaje" class="mt-4 text-sm text-center font-medium"></p>
        </div>

        <script>
            import {
                CognitoIdentityProviderClient,
                InitiateAuthCommand,
                RespondToAuthChallengeCommand,
            } from "@aws-sdk/client-cognito-identity-provider";

            const REGION = "us-east-1";
            const CLIENT_ID = "4ul825nprfht1evlpqmf5v5jd3";

            const client = new CognitoIdentityProviderClient({
                region: REGION,
            });

            let cognitoSession: string | undefined = undefined;
            let currentEmail: string | undefined = undefined;

            const loginForm = document.getElementById("loginForm");
            const emailInput = document.getElementById("email") as HTMLInputElement | null;
            const passwordInput = document.getElementById("password") as HTMLInputElement | null;
            const newPasswordInput = document.getElementById("newPassword") as HTMLInputElement | null;
            const divPasswordActual = document.getElementById("divPasswordActual");
            const divNuevaPassword = document.getElementById("divNuevaPassword");
            const msgEl = document.getElementById("mensaje");
            const btnSubmit = document.getElementById("btnSubmit") as HTMLButtonElement | null;

            loginForm?.addEventListener("submit", async (e) => {
                e.preventDefault();
                const email = emailInput?.value || "";
                const password = passwordInput?.value || "";
                const newPassword = newPasswordInput?.value || "";

                if (msgEl) {
                    msgEl.textContent = "Procesando...";
                    msgEl.className = "mt-4 text-sm text-center text-slate-500";
                }
                if (btnSubmit) {
                    btnSubmit.disabled = true;
                }

                try {
                    if (!cognitoSession) {
                        currentEmail = email;
                        const command = new InitiateAuthCommand({
                            AuthFlow: "USER_PASSWORD_AUTH",
                            ClientId: CLIENT_ID,
                            AuthParameters: {
                                USERNAME: email,
                                PASSWORD: password,
                            },
                        });

                        const response = await client.send(command);

                        if (
                            response.ChallengeName ===
                            "NEW_PASSWORD_REQUIRED"
                        ) {
                            cognitoSession = response.Session;
                            divPasswordActual?.classList.add("hidden");
                            divNuevaPassword?.classList.remove("hidden");
                            if (newPasswordInput) {
                                newPasswordInput.required = true;
                            }
                            if (btnSubmit) {
                                btnSubmit.textContent = "Establecer y Entrar";
                                btnSubmit.disabled = false;
                            }

                            if (msgEl) {
                                msgEl.textContent =
                                    "Se requiere cambio de contraseña.";
                                msgEl.className =
                                    "mt-4 text-sm text-center text-orange-600";
                            }
                            return;
                        }

                        if (response.AuthenticationResult?.IdToken) {
                            procesarLoginExitoso(
                                response.AuthenticationResult.IdToken,
                                msgEl,
                            );
                        } else {
                            throw new Error("No se recibió el token de autenticación.");
                        }
                    } else {
                        const command = new RespondToAuthChallengeCommand({
                            ChallengeName: "NEW_PASSWORD_REQUIRED",
                            ClientId: CLIENT_ID,
                            Session: cognitoSession,
                            ChallengeResponses: {
                                USERNAME: currentEmail || "",
                                NEW_PASSWORD: newPassword,
                            },
                        });

                        const response = await client.send(command);
                        if (response.AuthenticationResult?.IdToken) {
                            procesarLoginExitoso(
                                response.AuthenticationResult.IdToken,
                                msgEl,
                            );
                        } else {
                            throw new Error("No se recibió el token de autenticación.");
                        }
                    }
                } catch (error) {
                    console.error(error);
                    const errorMessage =
                        error instanceof Error
                            ? error.message
                            : "Credenciales inválidas";
                    if (msgEl) {
                        msgEl.textContent = "Error: " + errorMessage;
                        msgEl.className =
                            "mt-4 text-sm text-center text-red-600";
                    }
                    cognitoSession = undefined;
                    if (btnSubmit) {
                        btnSubmit.disabled = false;
                    }
                }
            });

            function procesarLoginExitoso(idToken: string, msgEl: HTMLElement | null) {
                // Almacenar el token localmente para usarlo en futuras peticiones a API Gateway
                localStorage.setItem("sportmind_token", idToken);

                try {
                    const payload = JSON.parse(atob(idToken.split(".")[1]));
                    const grupos = (payload["cognito:groups"] as string[] | undefined) || ["sin grupo"];

                    if (msgEl) {
                        msgEl.textContent = `¡Bienvenido! Rol: ${grupos.join(", ")}. Redirigiendo al dashboard...`;
                        msgEl.className = "mt-4 text-sm text-center text-green-600";
                    }
                } catch {
                    if (msgEl) {
                        msgEl.textContent = "¡Bienvenido! Redirigiendo al dashboard...";
                        msgEl.className = "mt-4 text-sm text-center text-green-600";
                    }
                }

                const btnSubmit = document.getElementById("btnSubmit") as HTMLButtonElement | null;
                if (btnSubmit) {
                    btnSubmit.disabled = true;
                }

                // Redirigir directamente al dashboard
                setTimeout(() => {
                    window.location.replace("/dashboard");
                }, 600);
            }
        </script>
    </body>
</html>
