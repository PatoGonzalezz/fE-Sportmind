---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <div class="max-w-6xl mx-auto space-y-6">
        
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
            <div>
                <h1 class="text-xl font-bold text-white">Visor de Logs</h1>
                <p class="text-xs text-slate-400 mt-0.5">Registro de auditoría y eventos del sistema (Solo lectura).</p>
            </div>
            <div class="text-xs font-mono text-slate-400 bg-slate-900 border border-slate-800 px-3 py-1.5 rounded-lg">
                Estado: <span class="text-emerald-400">● Conectado</span>
            </div>
        </div>

        <!-- Consola / Visor de Texto (Solo Ver) -->
        <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4 font-mono text-xs text-slate-300 shadow-xl overflow-hidden">
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-800/80 text-slate-500 text-[11px]">
                <span>[SYSTEM_LOG_STREAM_ACTIVE]</span>
                <span>Encoding: UTF-8</span>
            </div>

            <!-- Contenedor del texto de los logs -->
            <div class="space-y-2 max-h-[60vh] overflow-y-auto pr-2 select-text">
                <div class="text-slate-500">[2026-09-25 18:30:12] [INFO] AuthService: Token JWT validado correctamente para usuario Cognito.</div>
                <div class="text-amber-400/90">[2026-09-25 18:28:45] [WARN] S3Sync: Retraso en la respuesta del bucket (latencia > 800ms).</div>
                <div class="text-slate-500">[2026-09-25 18:15:00] [INFO] Dashboard: 11 registros cargados exitosamente desde caché local.</div>
                <div class="text-rose-400">[2026-09-25 17:50:22] [ERROR] Database: Excepción capturada en sp_guardar_error: conexión rechazada temporalmente.</div>
                <div class="text-slate-500">[2026-09-25 17:10:05] [INFO] Router: Redirección automática aplicada por falta de sesión activa.</div>
                <div class="text-slate-500">[2026-09-25 16:45:30] [INFO] Vite: Compilación de módulos completada sin errores.</div>
            </div>
        </div>
    </div>

    <script>
        // Visor estático de solo lectura
        document.getElementById("logout-btn")?.addEventListener("click", () => {
            localStorage.removeItem("sportmind_token");
            window.location.replace("/login");
        });
    </script>
</Layout>