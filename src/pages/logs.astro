---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <div class="max-w-6xl mx-auto space-y-6">
        
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
            <div>
                <h1 class="text-xl font-bold text-white">Visor de Logs</h1>
                <p class="text-xs text-slate-400 mt-0.5">Registro de auditoría y eventos del sistema (Solo lectura).</p>
            </div>
            <div class="flex items-center gap-2">
                <button id="btn-limpiar-logs" class="px-3 py-1.5 rounded-lg bg-rose-900/50 hover:bg-rose-800/80 text-rose-300 text-xs transition">
                    Limpiar historial
                </button>
                <div class="text-xs font-mono text-slate-400 bg-slate-900 border border-slate-800 px-3 py-1.5 rounded-lg">
                    Estado: <span class="text-emerald-400">● Conectado</span>
                </div>
            </div>
        </div>

        <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4 font-mono text-xs text-slate-300 shadow-xl overflow-hidden">
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-800/80 text-slate-500 text-[11px]">
                <span>[SYSTEM_LOG_STREAM_ACTIVE]</span>
                <span>Encoding: UTF-8</span>
            </div>

            <!-- Aquí se inyectarán los logs -->
            <div id="contenedor-logs" class="space-y-2 max-h-[60vh] overflow-y-auto pr-2 select-text">
            </div>
        </div>
    </div>

    <script>
        const contenedorLogs = document.getElementById('contenedor-logs');
        const btnLimpiar = document.getElementById('btn-limpiar-logs');

        function cargarLogs() {
            if (!contenedorLogs) return;
            
            const historial = JSON.parse(localStorage.getItem('sportmind_logs') || '[]');
            
            if (historial.length === 0) {
                contenedorLogs.innerHTML = '<div class="text-slate-600 italic">No hay eventos registrados en el sistema...</div>';
                return;
            }

            contenedorLogs.innerHTML = ''; 
            
            historial.reverse().forEach((log: string) => {
                const div = document.createElement('div');
                div.className = "text-slate-400 hover:text-slate-300 transition-colors";
                div.textContent = log;
                contenedorLogs.appendChild(div);
            });
        }

        btnLimpiar?.addEventListener('click', () => {
            localStorage.removeItem('sportmind_logs');
            cargarLogs();
        });

        cargarLogs();
    </script>
</Layout>