---
import '../../layouts/Layout.astro';
import Layout from '../../layouts/Layout.astro';
---

<Layout>
    <div class="max-w-4xl mx-auto space-y-6">
        
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
            <div>
                <h1 class="text-xl font-bold text-white">Crear Nuevo Especialista</h1>
                <p class="text-xs text-slate-400 mt-0.5">Asigna credenciales y registra un nuevo profesional en el sistema.</p>
            </div>
            <a href="/dashboard" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs transition">
                Volver
            </a>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-lg">
            <form id="form-especialista" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">Nombre</label>
                        <input type="text" id="nombre" required class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-indigo-500" placeholder="Nombre completo">
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">Correo electrónico</label>
                        <input type="email" id="email" required class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-indigo-500" placeholder="correo@sportmind.com">
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">Especialidad</label>
                        <select id="rol" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-indigo-500">
                            <option value="psicologo">Psicólogo Deportivo</option>
                            <option value="preparador">Preparador Físico</option>
                            <option value="kinesiologo">Kinesiólogo</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">Teléfono</label>
                        <input type="text" id="telefono" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-indigo-500" placeholder="+569...">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Contraseña temporal</label>
                    <input type="password" id="password" required class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-indigo-500" placeholder="••••••••">
                </div>

                <div class="flex justify-end gap-2 pt-4 border-t border-slate-800">
                    <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-medium transition">
                        Guardar especialista
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="toast" class="fixed bottom-4 right-4 bg-emerald-600 text-white text-xs px-3 py-2 rounded-lg shadow-lg opacity-0 transition-opacity pointer-events-none">
        Especialista creado correctamente
    </div>

    <script>
        // TODO: conectar con la API de Cognito cuando esté lista la ruta backend
        const form = document.getElementById('form-especialista') as HTMLFormElement;
        const toast = document.getElementById('toast');

        form?.addEventListener('submit', (e) => {
            e.preventDefault();
            console.log("Enviando formulario de especialista..."); // Debug temporal

            if (toast) {
                toast.classList.remove('opacity-0');
                setTimeout(() => {
                    toast.classList.add('opacity-0');
                }, 2500);
            }
            form.reset();
        });

        document.getElementById("logout-btn")?.addEventListener("click", () => {
            localStorage.removeItem("sportmind_token");
            window.location.replace("/login");
        });
    </script>
</Layout>