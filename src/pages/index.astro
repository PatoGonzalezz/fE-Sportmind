---
import "../styles/global.css";
---

<div id="loading">Cargando datos desde AWS S3...</div>
<div id="contenido"></div>

<script>
	import { fetchSportmindData } from "../services/sportmindService";

	async function cargarDatosS3() {
		try {
			const datos = await fetchSportmindData();
			const contenedor = document.getElementById("contenido");
			const loader = document.getElementById("loading");

			if (loader) loader.style.display = "none";
			if (contenedor) {
				contenedor.innerHTML = `<pre>${JSON.stringify(datos, null, 2)}</pre>`;
			}
		} catch (error) {
			console.error("Error cargando los datos desde S3:", error);
		}
	}

	cargarDatosS3();
</script>
