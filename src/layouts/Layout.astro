---
import '../styles/global.css';
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Sportmind Visualizer</title>
    
    <style>
      html:not(.auth-ok) body { display: none !important; }
    </style>
    
    <script is:inline>
      const token = localStorage.getItem('sportmind_token');
      if (token) {
        document.documentElement.classList.add('auth-ok');
      } else {
        window.location.replace('/login');
      }
    </script>
  </head>

  <body class="flex h-screen bg-[#0b1120] text-slate-200 overflow-hidden font-sans">
    
    <!-- Sidebar -->
    <aside class="w-[280px] h-full bg-[#111827] flex flex-col border-r border-slate-800 p-4 relative overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-32 h-16 bg-indigo-500/20 blur-3xl rounded-full pointer-events-none"></div>

      <div class="mb-8 px-2 relative z-10">
        <div class="flex items-center gap-3 mb-1">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex-shrink-0 flex items-center justify-center shadow-lg shadow-indigo-500/30">
            <span class="text-white text-xl">🧠</span>
          </div>
          <h1 class="text-xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-white to-slate-400 tracking-wide">Sportmind</h1>
        </div>
        <p class="text-xs text-slate-400 font-medium">Visualizer <span class="bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 px-1.5 py-0.5 rounded ml-1 text-[10px] uppercase tracking-wider">S3 Live</span></p>
      </div>

      <!-- Nav -->
      <nav class="flex flex-col gap-2.5 flex-1 relative z-10">
        <a href="/dashboard" class="group flex items-center gap-3 px-3 py-2.5 rounded-xl bg-indigo-500/10 text-indigo-400 font-medium border border-indigo-500/20 transition-all shadow-[0_0_15px_rgba(99,102,241,0.05)]">
          <div class="bg-indigo-500/20 p-1.5 rounded-lg group-hover:scale-110 transition-transform">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
          </div>
          Evaluaciones
        </a>

        <a href="/logs" class="group flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-800/50 text-slate-400 hover:text-slate-200 transition-all border border-transparent hover:border-slate-700/50">
          <div class="bg-slate-800/50 p-1.5 rounded-lg group-hover:scale-110 group-hover:bg-slate-700 transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          </div>
          Logs
        </a>

        <a href="/especialista/crear" class="group flex items-center justify-between px-3 py-2.5 rounded-xl hover:bg-emerald-500/10 text-slate-400 hover:text-emerald-400 transition-all border border-transparent hover:border-emerald-500/20">
          <div class="flex items-center gap-3">
            <div class="bg-slate-800/50 group-hover:bg-emerald-500/20 p-1.5 rounded-lg group-hover:scale-110 transition-all text-slate-400 group-hover:text-emerald-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
            </div>
            <span>Crear Especialista</span>
          </div>
          <span class="opacity-0 group-hover:opacity-100 transition-opacity text-emerald-400 font-bold bg-emerald-500/20 px-1.5 rounded text-[10px] tracking-widest">+ NUEVO</span>
        </a>
      </nav>

      <!-- Actions -->
      <div class="mt-auto flex flex-col gap-2 pt-4 border-t border-slate-800 relative z-10">
        <button id="btn-refresh-s3" class="w-full flex items-center justify-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg transition-all shadow-lg shadow-indigo-600/20 active:scale-95 text-sm font-medium">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          Actualizar S3
        </button>
        <button id="logout-btn" class="w-full flex items-center justify-center gap-2 px-4 py-2 hover:bg-rose-500/10 text-rose-400 hover:text-rose-300 rounded-lg transition-colors text-sm font-medium">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
          Salir
        </button>
      </div>
    </aside>

    <main class="flex-1 overflow-y-auto p-6 md:p-8 relative">
      <slot />
    </main>
  </body>
</html>